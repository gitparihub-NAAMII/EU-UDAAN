*.swp

# Local agent settings
.claude/settings.local.json

# Source binaries — large authoring artifacts are referenced, not committed.
# See source/README.md for where they live and how to point at them.
source/**/*.pptx
source/**/*.docx
source/**/*.xlsx
source/**/*.pdf
source/**/*.key
!source/README.md
!source/MANIFEST.yaml

# Workshop binaries — decks and handouts live locally; each has a generated .md twin.
6-workshops/**/*.pptx
6-workshops/**/*.docx
6-workshops/**/*.xlsx
6-workshops/**/*.pdf
6-workshops/**/*.key
# ...except the deck in each session's final/ folder: the one you deliver lives in GitHub.
!6-workshops/**/final/deck/*.pptx

# Build output
dist/
build/
*.log

